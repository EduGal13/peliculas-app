# Copia este archivo como ".env" y llena tus datos (el .env NO se sube a GitHub)
PORT=3000

# Conexión a PostgreSQL (la misma que usarás en DBeaver)
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/peliculas_db

# Cambia esto por una frase larga y aleatoria
JWT_SECRET=cambia_esta_clave_por_una_muy_larga_y_secreta
JWT_EXPIRES_IN=8h

# Solo en Render / hosting con SSL: true
DB_SSL=false
